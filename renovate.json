{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>on2e/renovate-config",
    ":automergeMinor",
    ":automergeDigest",
    ":skipStatusChecks"
  ],
  "pyenv": {
    "enabled": false
  },
  "pip_requirements": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update `*_version` variables (case insensitive) in Ansible role variables files",
      "managerFilePatterns": [
        "/^\\.ansible/roles/[^/]+/vars/[^/]+\\.ya?ml$/",
        "/^\\.ansible/roles/[^/]+/defaults/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: packageName=(?<packageName>.+?))?(?: versioning=(?<versioning>.+?))?(?: extractVersion=(?<extractVersion>.+?))?\\s+[a-zA-Z_][\\w]*?_(?i:version)\\s*:\\s+[\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Use semantic commit scope `ansible` for all Ansible updates",
      "matchFileNames": ["\\.ansible/**"],
      "additionalBranchPrefix": "ansible-",
      "semanticCommitScope": "ansible",
      "commitMessageTopic": "{{depName}}",
      "separateMajorMinor": false
    },
    {
      "description": "For Ansible Galaxy updates, specify in the commit message whether it's a role or collection update",
      "matchManagers": ["ansible-galaxy"],
      "matchFileNames": ["/^\\.ansible/requirements\\.ya?ml$/"],
      "commitMessageTopic": "{{#if (equals depType 'role')}}role{{else}}collection{{/if}} {{depName}}"
    }
  ]
}
